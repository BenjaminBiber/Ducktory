@page "/"
@using AutoMapper
@using DuckLibrary.MappingModels
@using DuckLibrary.Models
@using DuckLibrary.Services
@using Ducktory.Components.Components
@inject IJSRuntime Js
@inject CmsService Cms

<PageTitle>Enten-Konfigurator</PageTitle>

<div class="row main-container">
    @*Canvas*@
    <div class="col-lg-6 col-12">
        <canvas class="w-100 h-100" id="myCanvas"></canvas>
    </div>
    
    @*Controls*@
    <div class="col-lg-6 col-12 pa-3">
        <DuckPartControl IsLegend="true"></DuckPartControl>
        @for (int i = 0; i < DuckParts.Count; i++)
        {
            <DuckPartControl @bind-Value="DuckParts[i]" />
        }
    </div>
</div>

@code {
    
    private List<DuckPart> DuckParts { get; set; } = new List<DuckPart>();

    protected override async Task OnInitializedAsync()
    {
        var test = await Cms.GetItems<List<DuckPart>, DuckPartDto>("DuckParts", "/collections/albums");
    }

    private async Task CopyPicture()
    {
        await Js.InvokeVoidAsync("CopyCanvasToClipboard");
    }
    
    private async Task GetPicture()
    {
        await Js.InvokeVoidAsync("DownloadImage");
    }
}