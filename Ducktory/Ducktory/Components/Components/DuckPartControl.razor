@using DuckLibrary.Models

<div class="row g-0 mb-2">
    <div class="col-2 d-flex align-items-center justify-content-center">
        @if (!IsLegend)
        {
            <img class="w-50 h-75 mr-2" src="@Value.CurrentPicture.Bild.Original" alt="@Value.CurrentPicture.Name"/>
        }
    </div>
    <div class="col-2 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Sortierreihenfolge</MudText>
        }
        else
        {
            <MudNumericField Min="0" T="int" Value="Value.SortOrder" ValueChanged="(int value) => SortOrderChanged(value)" Immediate="true"/>
        }
    </div>
    <div class="col-1 d-flex align-items-center justify-content-end">
        @if (!IsLegend)
        {
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowLeft" Variant="Variant.Text" Size="Size.Large" Color="Color.Primary" OnClick="LeftButtonClick"></MudIconButton>
        }
    </div>
    <div class="col-4 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Ebene</MudText>
        }
        else
        {
            <MudText Class="fw-bold">
                @Value.Name
            </MudText>
        }

    </div>
    <div class="col-1 d-flex align-items-center justify-content-start">
        @if (!IsLegend)
        {
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowRight" Size="Size.Large" Variant="Variant.Text" Color="Color.Primary" OnClick="RightButtonClick"></MudIconButton>
        }
    </div>
    <div class="col-2 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Ist Sichtbar</MudText>
        }
        else
        {
            <MudToggleIconButton Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" Color="Color.Default" ToggledChanged="(bool value) => VisibilityChanged(value)" ToggledIcon="@Icons.Material.Filled.Visibility" Toggled="Value.IsVisible"></MudToggleIconButton>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsLegend { get; set; }
    
    [Parameter] public DuckPart Value { get; set; } = new DuckPart();
    [Parameter] public EventCallback<DuckPart> ValueChanged { get; set; }

    private int CurrentPictureIndex => GetCurrentPictureIndex();
    private bool DisableButtons => Value.Images.Count < 2;
    
    private int GetCurrentPictureIndex()
    {
        return Value.Images.IndexOf(Value.CurrentPicture);
    }
        
    private async Task RightButtonClick()
    {
        int nextIndex = (CurrentPictureIndex + 1) % Value.Images.Count;

        Value.CurrentPicture = Value.Images[nextIndex];
        await ValueChanged.InvokeAsync(Value);
    }
    
    private async Task LeftButtonClick()
    {
        int nextIndex = (CurrentPictureIndex - 1 + Value.Images.Count) % Value.Images.Count;

        Value.CurrentPicture = Value.Images[nextIndex];
        await ValueChanged.InvokeAsync(Value);
    }
    
    private async Task SortOrderChanged(int value)
    {
        Value.SortOrder = value;
        await ValueChanged.InvokeAsync(Value);
    }
    
    private async Task VisibilityChanged(bool value)
    {
        Value.IsVisible = value;
        await ValueChanged.InvokeAsync(Value);
    }
}