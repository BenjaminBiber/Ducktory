@using DuckLibrary.Models

<div class="row g-0 mb-2">
    <div class="col-2 d-none d-lg-flex align-items-center justify-content-center">
        @if (!IsLegend && Value.CurrentPicture != null)
        {
            <img class="w-50 h-75 mr-2" src="@Value.CurrentPicture.Bild.Original" alt="@Value.CurrentPicture.Name"/>
        }
    </div>
    <div class="col-2 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Sortierreihenfolge</MudText>
        }
        else
        {
            <MudNumericField Min="0" T="int" Value="Value.SortOrder" ValueChanged="(int value) => SortOrderChanged(value)" Immediate="true"/>
        }
    </div>
    <div class="col d-flex align-items-center justify-content-end">
        @if (!IsLegend)
        {
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowLeft" Variant="Variant.Text" Class="d-none d-lg-flex" Size="Size.Large" Color="Color.Primary" OnClick="LeftButtonClick"></MudIconButton>
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowLeft" Variant="Variant.Text" Class="d-flex d-lg-none" Size="Size.Medium" Color="Color.Primary" OnClick="LeftButtonClick"></MudIconButton>
        }
    </div>
    <div class="col-3 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Ebene</MudText>
        }
        else
        {
            <MudText Class="fw-bold d-flex d-lg-none">
                @Value.Name
            </MudText>
            <MudText Typo="Typo.body1" Class="fw-bold d-none d-lg-flex">
                @Value.Name
            </MudText>
        }

    </div>
    <div class="col d-flex align-items-center justify-content-start">
        @if (!IsLegend)
        {
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowRight" Class="d-none d-lg-flex" Size="Size.Large" Variant="Variant.Text" Color="Color.Primary" OnClick="RightButtonClick"></MudIconButton>
            <MudIconButton Disabled="DisableButtons" Icon="@Icons.Material.Filled.ArrowRight" Class="d-flex d-lg-none" Size="Size.Medium" Variant="Variant.Text" Color="Color.Primary" OnClick="RightButtonClick"></MudIconButton>
        }
    </div>
    <div class="col-2 d-flex align-items-center justify-content-center">
        @if (IsLegend)
        {
            <MudText>Ist Sichtbar</MudText>
        }
        else
        {
            <MudToggleIconButton Class="d-none d-lg-flex" Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Large" Color="Color.Default" ToggledChanged="(bool value) => VisibilityChanged(value)" ToggledIcon="@Icons.Material.Filled.Visibility" Toggled="Value.IsVisible"></MudToggleIconButton>
            <MudToggleIconButton Class="d-flex d-lg-none" Icon="@Icons.Material.Filled.VisibilityOff" Size="Size.Medium" Color="Color.Default" ToggledChanged="(bool value) => VisibilityChanged(value)" ToggledIcon="@Icons.Material.Filled.Visibility" Toggled="Value.IsVisible"></MudToggleIconButton>
        }
    </div>
</div>

@code {
    [Parameter] public bool IsLegend { get; set; }
    
    [Parameter] public DuckPart Value { get; set; } = new DuckPart();
    [Parameter] public EventCallback<DuckPart> ValueChanged { get; set; }
    
    [Parameter] public List<DuckPart> ListValue { get; set; } = new List<DuckPart>();
    [Parameter] public EventCallback<List<DuckPart>> ListValueChanged { get; set; }

    private int CurrentPictureIndex => GetCurrentPictureIndex();
    private bool DisableButtons => Value.Images.Count < 2;
    
    private int GetCurrentPictureIndex()
    {
        return Value.Images.IndexOf(Value.CurrentPicture);
    }
        
    private async Task RightButtonClick()
    {
        int nextIndex = (CurrentPictureIndex + 1) % Value.Images.Count;

        Value.CurrentPicture = Value.Images[nextIndex];
        await ValueChanged.InvokeAsync(Value);
    }
    
    private async Task LeftButtonClick()
    {
        int nextIndex = (CurrentPictureIndex - 1 + Value.Images.Count) % Value.Images.Count;

        Value.CurrentPicture = Value.Images[nextIndex];
        await ValueChanged.InvokeAsync(Value);
    }
    
    private async Task SortOrderChanged(int value)
    {
        var currentSortOrder = Value.SortOrder;
        var element = ListValue.FirstOrDefault(x => x.SortOrder == value) ?? null;
        if (element != null)
        {
            ListValue[ListValue.IndexOf(element)].SortOrder = currentSortOrder;
        }
        Value.SortOrder = value;
        await ListValueChanged.InvokeAsync(ListValue);
        await ValueChanged.InvokeAsync(Value);
        StateHasChanged();
    }
    
    private async Task VisibilityChanged(bool value)
    {
        Value.IsVisible = value;
        await ValueChanged.InvokeAsync(Value);
    }
}